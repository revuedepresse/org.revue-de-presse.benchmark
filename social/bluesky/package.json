{
  "name": "@revue-de-presse/social-bluesky",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "CLI that posts a daily Revue de Presse top-3 thread to a Bluesky account once per day from cron.",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/revue-de-presse/org.revue-de-presse.benchmark.git",
    "directory": "social/bluesky"
  },
  "bugs": {
    "url": "https://github.com/revue-de-presse/org.revue-de-presse.benchmark/issues"
  },
  "homepage": "https://github.com/revue-de-presse/org.revue-de-presse.benchmark/tree/main/social/bluesky#readme",
  "keywords": [
    "bluesky",
    "atproto",
    "cron",
    "press",
    "social",
    "cli"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "post": "node --env-file=.env.local --import tsx bin/post-daily-top3.ts",
    "post:dry": "node --env-file=.env.local --import tsx bin/post-daily-top3.ts --dry-run",
    "bootstrap": "node --env-file=.env.local --import tsx bin/bootstrap-auth.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@atproto/api": "^0.13.35",
    "@atproto/jwk-jose": "^0.1.11",
    "@atproto/oauth-client-node": "^0.2.24",
    "pino": "^10.3.1",
    "sharp": "^0.35.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "vite": "^7.3.6"
    }
  }
}
