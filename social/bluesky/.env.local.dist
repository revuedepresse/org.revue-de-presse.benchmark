# Posting identity — your verified Bluesky handle. Default points to the
# upstream Revue de Presse handle; override when forking.
BLUESKY_HANDLE=revue-de-presse.org

# Atproto OAuth client. The metadata JSON must be hosted at a publicly-
# resolvable HTTPS URL (see nuxt/public/bluesky-client-metadata.json). The
# URL IS the client_id per the atproto OAuth profile.
BLUESKY_CLIENT_METADATA_URL=https://revue-de-presse.org/bluesky-client-metadata.json

# Must match a redirect_uris entry in the metadata document. Used only by
# `make bluesky-bootstrap`; cron does not need a live HTTP endpoint.
# Per RFC 8252, the auth server accepts any port at runtime as long as the
# host + path match, so an operator unable to bind 8080 can change the port
# here without re-publishing the metadata.
BLUESKY_REDIRECT_URI=http://127.0.0.1:8080/callback

# PDS to authenticate against. Default is the public Bluesky PDS; only change
# for self-hosted PDS deployments.
BLUESKY_PDS_URL=https://bsky.social

# Local file paths. Both gitignored. Optional in env mode (see
# BLUESKY_OAUTH_SESSION below).
BLUESKY_SESSION_FILE=./.bluesky-session.json
BLUESKY_STATE_FILE=./.bluesky-state.json

# CI / env mode (alternative to the session file). When set, the CLI reads
# the base64-encoded JSON session from this env var and does NOT write the
# session file. Pair with BLUESKY_ROTATED_SESSION_FILE so the workflow can
# push the rotated session back into its secret store.
# BLUESKY_OAUTH_SESSION=
# BLUESKY_ROTATED_SESSION_FILE=

# Upstream Revue de Presse API (same shape as social/linkedin).
API_BASE_URL=https://api.revue-de-presse.org
API_CLIENT_SECRET=

# Logging + timezone.
LOG_LEVEL=info
TZ=Europe/Paris

# Optional commentary (lead post only). Forks override or leave blank.
#   POST_FOOTER_URL  prints as "Retrouvez la revue de presse complète : <url>"
#   POST_HASHTAG     prints as the final line of the lead post.
# Either one dropped if it would push the lead post past 300 graphemes.
# NOTE: Node's --env-file parser treats `#` as a comment marker. The hashtag
# value MUST be quoted or the leading `#` truncates the value to empty.
POST_FOOTER_URL=https://play.google.com/store/apps/details?id=org.revue_2_presse
POST_HASHTAG="#RevueDePresse"
