# TikTok developer-portal app credentials. Create at
# https://developers.tiktok.com/apps/ with Login Kit + Content Posting API.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Initial refresh token: obtained by running `make tiktok-bootstrap`.
# Rotated on every daily run. 365-day TTL per TikTok Login Kit v2 docs.
TIKTOK_REFRESH_TOKEN=

# Fine-grained GitHub PAT (Actions secrets read+write on this repo only).
# Used by the daily Action to persist the rotated refresh_token back to
# GitHub Secrets. Not needed in local runs.
TIKTOK_SECRET_ROTATOR_PAT=

# inbox (default) sends to the @revue_2_presse TikTok inbox for manual
# finalisation; direct posts straight to the profile (requires app audit).
PUBLISH_MODE=inbox

# Nuxt instance to drive with Playwright for the scrolling capture.
# Defaults to the production deploy; override to http://localhost:3000 for dev.
NUXT_CAPTURE_URL=https://revue-de-presse.org

# Upstream Revue de Presse API (same credentials as social/linkedin .env.local).
API_BASE_URL=https://api.revue-de-presse.org
API_CLIENT_SECRET=

# Logging + timezone.
LOG_LEVEL=info
TZ=Europe/Paris
