{
  "name": "@revue-de-presse/social-linkedin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "CLI that posts a daily Bluesky top-10 digest to a LinkedIn organization page once per day from cron.",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/revue-de-presse/org.revue-de-presse.benchmark.git",
    "directory": "social/linkedin"
  },
  "bugs": {
    "url": "https://github.com/revue-de-presse/org.revue-de-presse.benchmark/issues"
  },
  "homepage": "https://github.com/revue-de-presse/org.revue-de-presse.benchmark/tree/main/social/linkedin#readme",
  "keywords": ["linkedin", "bluesky", "cron", "press", "social", "cli"],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "post": "tsx bin/post-daily-top10.ts",
    "post:dry": "tsx bin/post-daily-top10.ts --dry-run",
    "bootstrap": "tsx bin/bootstrap-auth.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "linkedin-api-client": "^0.3.0",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
