# LinkedIn developer-portal app credentials. Generate at
# https://www.linkedin.com/developers/apps and associate the app with the
# organization at https://www.linkedin.com/company/75720423/admin/settings/.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Must match the "Authorized redirect URLs" entry on the LinkedIn app's Auth tab.
# Used only by `make linkedin-bootstrap`; cron does not need a live HTTP endpoint.
LINKEDIN_REDIRECT_URI=https://localhost:8080/callback

# Author of the post. Set this to YOUR LinkedIn organization page URN
# when forking this workspace. The default points to the upstream
# Revue de Presse organization page.
LINKEDIN_ORGANIZATION_URN=urn:li:organization:75720423

# LinkedIn versioned-API header pin. Bump when LinkedIn deprecates the version.
LINKEDIN_VERSION=202505

# Local file paths used by the CLI. Both are gitignored. Relative paths are
# resolved from the cron CWD (the workspace root).
LINKEDIN_TOKEN_FILE=./.linkedin-token.json
LINKEDIN_STATE_FILE=./.linkedin-state.json

# Upstream Revue de Presse API (same credentials as nuxt/next .env files).
API_BASE_URL=https://api.revue-de-presse.org
API_CLIENT_SECRET=

# Logging + timezone.
LOG_LEVEL=info
TZ=Europe/Paris

# Optional commentary footer. Forks can override or leave empty to omit.
#   POST_FOOTER_URL  prints as "Retrouvez la revue de presse complète : <url>"
#   POST_HASHTAG     prints as the final line of the commentary.
# Leave either blank to drop that section.
POST_FOOTER_URL=https://play.google.com/store/apps/details?id=org.revue_2_presse
POST_HASHTAG=#RevueDePresse
