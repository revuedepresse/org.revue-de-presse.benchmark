{
  "name": "@revue-de-presse/e2e",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "test": "playwright test",
    "test:functional": "playwright test --project='*-functional'",
    "test:perf": "playwright test --project='*-perf'",
    "typecheck": "tsc --noEmit",
    "parity:capture": "playwright test --project=nuxt-desktop-parity",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "install-browsers": "playwright install --with-deps chromium",
    "maestro:android": "maestro test maestro/flows/",
    "maestro:ios": "maestro test maestro/flows/"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "chrome-launcher": "^1.2.2",
    "lighthouse": "^13.5.0",
    "playwright-lighthouse": "^4.0.0",
    "typescript": "^7.0.2",
    "web-vitals": "^4.2.4"
  }
}
