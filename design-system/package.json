{
  "name": "@revue-de-presse/design-system-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build:tokens": "node scripts/sync-tokens.mjs --check",
    "tokens:sync": "node scripts/sync-tokens.mjs --write",
    "build:mitosis": "mitosis build && node scripts/post-mitosis.mjs",
    "build": "pnpm build:tokens && pnpm build:mitosis",
    "test": "vitest run",
    "test:scripts": "node --test scripts/__tests__/*.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "demo": "pnpm --filter @revue-de-presse/design-system-demo dev",
    "story": "histoire dev --config stories/histoire.config.ts",
    "verify:cross-target": "node scripts/verify-cross-target.mjs",
    "verify:visual": "node scripts/visual-regression.mjs"
  },
  "devDependencies": {
    "@angular/common": "^20.3.26",
    "@angular/core": "^20.3.26",
    "@builder.io/mitosis": "^0.13.2",
    "@builder.io/mitosis-cli": "^0.13.2",
    "@builder.io/qwik": "^1.20.0",
    "@histoire/plugin-vue": "^0.17.17",
    "@stencil/core": "^4.43.5",
    "@types/node": "^25.9.5",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@zxcvbn-ts/core": "^3.0.4",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-en": "^3.0.2",
    "@zxcvbn-ts/language-fr": "^3.0.2",
    "alpinejs": "^3.15.12",
    "histoire": "^0.17.17",
    "lit": "^3.3.3",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.62.0",
    "pngjs": "^7.0.0",
    "preact": "^10.29.7",
    "solid-js": "^1.9.14",
    "svelte": "^5.56.8",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vite-plugin-solid": "^2.11.13",
    "vitest": "^4.1.10",
    "vue": "^3.5.40"
  },
  "pnpm": {
    "overrides": {
      "vite": "^8.0.16",
      "esbuild": "^0.25.0",
      "svelte": "^5.55.9",
      "@tootallnate/once": "^3.0.1",
      "@builder.io/mitosis>@angular/compiler": "^20.0.0",
      "linkify-it": "^5.0.2",
      "markdown-it": "^14.2.0",
      "@babel/core": "^7.29.6",
      "brace-expansion": "^5.0.8"
    }
  }
}
