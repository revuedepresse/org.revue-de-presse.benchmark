# Upstream highlights API (API Platform). The Nitro server reads these and proxies
# /api/highlights → ${NUXT_API_BASE_URL}/api/highlights, attaching a short-lived
# Bearer access token that it mints from ${NUXT_API_BASE_URL}/api/token using
# NUXT_API_CLIENT_SECRET as the long-lived client credential. The secret never
# reaches the browser.
NUXT_API_BASE_URL=https://api.revue-de-presse.org
NUXT_API_CLIENT_SECRET=replace-with-the-shared-client-secret

# --- Chat (Bluesky OAuth + signed JWT to the API) ---
#
# 256-bit shared HS256 secret with the API's BlueskyJwtAuthenticator.
# Mint with `make chat-jwt-secret` in the org.revue-de-presse.api repo
# and paste the SAME line here AND in that repo's .env.local AND into
# the Netlify env. Rotating invalidates every active chat session.
API_JWT_SECRET=

# Public origin where Nuxt serves /oauth/client-metadata.json. Leave
# empty in dev — the OAuth client then builds a localhost loopback
# client_id automatically. In prod: https://revue-de-presse.org
PUBLIC_ORIGIN=

# Where chat session + Bluesky OAuth state JSON files live on disk in
# dev. Optional; defaults to ./.session-store (gitignored).
# CHAT_SESSION_STORE_DIR=./.session-store
